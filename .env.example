SPRING_PROFILES_ACTIVE=supabase
DB_URL=jdbc:postgresql://[POOLER-HOST]:5432/postgres?sslmode=require
DB_USERNAME=postgres.[PROJECT-REF]
DB_PASSWORD=[YOUR-PASSWORD]
SERVER_PORT=8080
# Optional local disk directory for proxied public animal images.
# IMAGE_CACHE_DIR=./data/image-cache
# Use the portal Decoding key. An already percent-encoded Encoding key is also accepted.
# Two independent public sources exist (rescue-animal notices vs. loss reports); each picks its
# own key with the OPPOSITE priority so either variable alone configures both, and either can be
# overridden per source without affecting the other:
#   - rescue-animal (abandonment) source: ANIMAL_API_SERVICE_KEY first, then this one as fallback
#   - loss-report source:                 this one (LOSSINFO_API_KEY) first, then ANIMAL_API_SERVICE_KEY
LOSSINFO_API_KEY=[YOUR-DATA-GO-KR-DECODING-KEY]
# Set this only if the rescue-animal source needs a different key than LOSSINFO_API_KEY (same
# service group 1543061 makes this unlikely but unverified). Also still accepted, for backward
# compatibility, as the loss-report key when LOSSINFO_API_KEY is unset.
# ANIMAL_API_SERVICE_KEY=[YOUR-DATA-GO-KR-SERVICE-KEY]
# Optional: override either source's endpoint (defaults assume both live under service
# group 1543061; the rescue-animal path is unverified against a live response).
# ANIMAL_API_ABANDONMENT_URL=https://apis.data.go.kr/1543061/abandonmentPublicService_v2/abandonmentPublic_v2
# ANIMAL_API_LOSS_URL=https://apis.data.go.kr/1543061/lossInfoService/lossInfo
# Deprecated: pre-split, single-source override. Only the loss-report source still falls back to
# it (that's what it pointed at in practice); prefer ANIMAL_API_LOSS_URL in new configuration.
# ANIMAL_API_URL=https://apis.data.go.kr/1543061/lossInfoService/lossInfo
# Only needed for protected manual sync requests:
# ANIMAL_SYNC_USERNAME=[SYNC-OPERATOR-USERNAME]
# ANIMAL_SYNC_PASSWORD=[SYNC-OPERATOR-PASSWORD]
